# Local PostgreSQL / Compose (never use these defaults in production)
POSTGRES_DB=cardhub
POSTGRES_USER=cardhub
POSTGRES_PASSWORD=cardhub
POSTGRES_PORT=5432
SERVER_PORT=8080

# Application security
JWT_SECRET=replace-with-at-least-32-random-bytes
# Local/test uses AES. Production defaults to KMS envelope encryption.
CIPHER_PROVIDER=aes
PII_ENCRYPTION_KEY=replace-with-a-long-random-local-development-key
PII_KEY_VERSION=local-v1
KMS_KEY_ID=
KMS_REGION=ap-northeast-2
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
OAUTH_SUCCESS_URL=http://localhost:3000/auth/callback

# OAuth profile only: start with SPRING_PROFILES_ACTIVE=local,oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# External adapter credentials. The MVP repository ships safe stubs; no secret is committed.
TOSS_SECRET_KEY=
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=7s
SWEETTRACKER_API_KEY=
SWEETTRACKER_CONNECT_TIMEOUT=3s
SWEETTRACKER_READ_TIMEOUT=7s
AWS_REGION=ap-northeast-2
S3_BUCKET=
CLOUDFRONT_BASE_URL=

# Worker
CARDHUB_WORKER_ENABLED=false
CARDHUB_WORKER_BATCH_SIZE=20
CARDHUB_WORKER_POLL_DELAY=1000
CARDHUB_WORKER_LEASE_TIMEOUT=PT5M
